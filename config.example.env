# YouTube WebSub Configuration
CALLBACK_URL_BASE=https://your-machine-name.your-tailnet.ts.net
YOUTUBE_CHANNEL_ID=YOUR_YOUTUBE_CHANNEL_ID_HERE
SECRET_KEY=change_this_to_a_random_string

# Discord Configuration
# Option 1: Use a webhook (easier)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Option 2: Use a bot (more control)
DISCORD_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
DISCORD_CHANNEL_ID=YOUR_CHANNEL_ID_HERE

# WhatsApp Configuration (Twilio or WhatsApp Business API)
WHATSAPP_API_KEY=your_api_key_here

# Facebook Configuration
FB_PAGE_ACCESS_TOKEN=your_page_access_token
FB_PAGE_ID=your_page_id

# Ghost/Email Configuration
GHOST_API_KEY=your_ghost_api_key
GHOST_URL=https://your-ghost-site.com
